# Copy this file to .env and fill in real values before running the server.

# SQLite by default — the file will be created automatically at server/dev.db
DATABASE_URL="file:./dev.db"

# Change this to a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-this-with-a-long-random-string"

# Port the API listens on
PORT=4000

# Comma-separated list of origins allowed to call the API.
# In production, set this to your real website domain(s).
CORS_ORIGIN="http://localhost:5173"

# Credentials used ONLY the first time you run the seed script, to create
# the first admin account you'll log into /admin with. Change the password
# immediately after your first login (there's no "change password" UI yet —
# see README for how to reset it via the seed script).
SEED_ADMIN_EMAIL="admin@coopada.it"
SEED_ADMIN_PASSWORD="ChangeMe123!"
